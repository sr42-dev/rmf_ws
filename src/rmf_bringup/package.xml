<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rmf_bringup</name>
  <version>0.0.0</version>
  <description>Launch files for bringing up RMF simulation and tests</description>
  <maintainer email="dev@todo.todo">dev</maintainer>
  <license>MIT</license>

  <exec_depend>robots_cv_sim</exec_depend>
  <exec_depend>robot_controller</exec_depend>
  <exec_depend>rmf_tests</exec_depend>
  <exec_depend>traffic_editor_assets</exec_depend>
  <exec_depend>fleet_adapter</exec_depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
